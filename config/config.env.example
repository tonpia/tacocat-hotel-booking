# Copy to config/config.env (gitignored) and fill in. Never commit config/config.env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, database name hotel-booking
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hotel-booking

JWT_SECRET=<long random string>
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Optional: requests per 10 minutes per IP (default 100)
RATE_LIMIT_MAX=100

{
  "info": {
    "name": "00 Smoke",
    "description": "Minimal checks that the API starts and auth works. Keep these passing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get me without a token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 without token', () => pm.response.to.have.status(401));",
              "pm.test('success is false', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me" }
    },
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 on login', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a token', () => pm.expect(body.token).to.be.a('string'));",
              "pm.environment.set('adminToken', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\" }"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Get me as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('role is admin', () => pm.expect(pm.response.json().data.role).to.eql('admin'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Login with wrong password fails",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('4xx on bad password', () => pm.expect(pm.response.code).to.be.within(400, 401));",
              "pm.test('no token', () => pm.expect(pm.response.json().token).to.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{user1Email}}\", \"password\": \"wrong-password\" }"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "GET /api-docs: Swagger documents auth, hotel and booking endpoints (A7, NFR4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const text = pm.response.text();",
              "const start = text.indexOf('\"swaggerDoc\":');",
              "pm.test('init script carries the OpenAPI document', () => pm.expect(start).to.be.above(-1));",
              "const doc = JSON.parse(text.slice(text.indexOf('{', start), text.indexOf('\"customOptions\"')).trim().replace(/,$/, '')).paths;",
              "const expected = { '/auth/register': ['post'], '/auth/login': ['post'], '/auth/me': ['get'], '/auth/logout': ['get'], '/hotels': ['get', 'post'], '/hotels/{id}': ['get', 'put', 'delete'], '/bookings': ['get'], '/hotels/{hotelId}/bookings': ['get', 'post'], '/bookings/{id}': ['get', 'put', 'delete'] };",
              "pm.test('every auth, hotel and booking endpoint of docs/api.md is documented', () => Object.entries(expected).forEach(([path, methods]) => { pm.expect(doc, path).to.have.property(path); methods.forEach((m) => pm.expect(doc[path], path + ' ' + m).to.have.property(m)); }));",
              "pm.test('booking error codes documented', () => { pm.expect(doc['/hotels/{hotelId}/bookings'].post.responses).to.include.all.keys('201', '400', '401', '404'); pm.expect(doc['/bookings/{id}'].get.responses).to.include.all.keys('200', '401', '403', '404'); pm.expect(doc['/bookings/{id}'].put.responses).to.include.all.keys('200', '400', '401', '403', '404'); pm.expect(doc['/bookings/{id}'].delete.responses).to.include.all.keys('200', '401', '403', '404'); });",
              "pm.test('auth and hotel error codes documented', () => { pm.expect(doc['/auth/register'].post.responses).to.include.all.keys('201', '400'); pm.expect(doc['/auth/login'].post.responses).to.include.all.keys('200', '401'); pm.expect(doc['/hotels'].post.responses).to.include.all.keys('201', '400', '401', '403'); pm.expect(doc['/hotels/{id}'].get.responses).to.include.all.keys('200', '404'); pm.expect(doc['/hotels/{id}'].put.responses).to.include.all.keys('200', '400', '401', '403', '404'); pm.expect(doc['/hotels/{id}'].delete.responses).to.include.all.keys('200', '401', '403', '404'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api-docs/swagger-ui-init.js"
      }
    }
  ]
}

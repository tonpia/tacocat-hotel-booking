{
  "info": {
    "name": "30 Bookings",
    "description": "Booking endpoints: rename (A1) and check-in/check-out dates (A3).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List bookings without token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/bookings",
        "header": []
      }
    },
    {
      "name": "Create booking without token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"checkInDate\": \"2027-12-01\", \"checkOutDate\": \"2027-12-03\"}"
        }
      }
    },
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",

{
  "info": {
    "name": "30 Bookings",
    "description": "Booking endpoints after the Appointment to Booking rename (A1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List bookings without token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/bookings",
        "header": []
      }
    },
    {
      "name": "Create booking without token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}/bookings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"apptDate\": \"2026-12-01\"}"
        }
      }
    },
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "Login user1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('user1Token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{user1Email}}\", \"password\": \"{{user1Password}}\"}"
        }
      }
    },
    {
      "name": "Create booking for missing hotel is 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels/000000000000000000000000/bookings",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"apptDate\": \"2026-12-01\"}"
        }
      }
    },
    {
      "name": "Create booking as user is 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('linked to hotel', () => pm.expect(pm.response.json().data.hotel).to.eql(pm.environment.get('hotel1Id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}/bookings",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"apptDate\": \"2026-12-01\"}"
        }
      }
    },
    {
      "name": "List own bookings",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('one booking', () => pm.expect(pm.response.json().count).to.eql(1));",
              "pm.test('hotel populated', () => pm.expect(pm.response.json().data[0].hotel.name).to.eql('Taco Hotel Bangkok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/bookings",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          }
        ]
      }
    },
    {
      "name": "List bookings of a hotel",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}/bookings",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      }
    },
    {
      "name": "Old /appointments path is gone",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/appointments",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          }
        ]
      }
    }
  ]
}
    {
      "name": "Create booking as user is 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('linked to hotel', () => pm.expect(pm.response.json().data.hotel).to.eql(pm.environment.get('hotel1Id')));",
              "pm.test('2 nights', () => pm.expect(pm.response.json().data.nights).to.eql(2));",
              "pm.test('has dates', () => { const d = pm.response.json().data; pm.expect(d.checkInDate).to.be.a('string'); pm.expect(d.checkOutDate).to.be.a('string'); });",
              "pm.test('no apptDate', () => pm.expect(pm.response.json().data).to.not.have.property('apptDate'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}/bookings",

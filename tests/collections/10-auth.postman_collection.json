    {
      "name": "Login ok is 200 with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('token returned', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.test('token cookie set', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('token='));",
              "pm.environment.set('user1Token', pm.response.json().token);"
            ]
          }
        }
      ],

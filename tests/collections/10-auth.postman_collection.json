{
  "info": {
    "name": "10 Auth",
    "description": "Register, login, me and logout (A2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register ok is 201 with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json(); pm.test('token returned', () => { pm.expect(j.success).to.eql(true); pm.expect(j.token).to.be.a('string'); });",
              "pm.environment.set('newToken', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"New User\", \"tel\": \"0833333333\", \"email\": \"newuser@test.com\", \"password\": \"newpass123\"}"
        }
      }
    },
    {
      "name": "Me returns tel",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('tel saved', () => pm.expect(pm.response.json().data.tel).to.eql('0833333333'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{newToken}}"
          }
        ]
      }
    },

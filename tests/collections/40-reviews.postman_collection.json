{
  "info": {
    "name": "40 Reviews",
    "description": "Hotel review feature (R1 to R5). B1: Review model rules and hotel averageRating/reviewCount. B4: public GET /hotels/:hotelId/reviews. B2: POST /bookings/:bookingId/reviews.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST review: not logged in gives 401 (R1; first, before any login sets a cookie)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('success false with a message', () => { const b = pm.response.json(); pm.expect(b.success).to.eql(false); pm.expect(b.message).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/bookings/{{user1PastBookingId}}/reviews",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\":3,\"comment\":\"Clean room, slow check-in\"}"
        }
      }
    },
    {
      "name": "Review model rejects invalid reviews (R1, R2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = JSON.parse(pm.environment.get('reviewModelRejects'));",
              "pm.test('rating 0 is rejected', () => pm.expect(r.rating0).to.eql('ValidationError'));",
              "pm.test('rating 6 is rejected', () => pm.expect(r.rating6).to.eql('ValidationError'));",
              "pm.test('rating 3.5 is rejected', () => pm.expect(r.rating3point5).to.eql('ValidationError'));",
              "pm.test('missing rating is rejected', () => pm.expect(r.ratingMissing).to.eql('ValidationError'));",
              "pm.test('comment over 1000 characters is rejected', () => pm.expect(r.comment1001).to.eql('ValidationError'));",
              "pm.test('second review for the same booking is rejected by the unique index', () => pm.expect(r.sameBooking).to.eql('DuplicateKey'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel2Id}}",
        "header": []
      }
    },

    {
      "name": "Hotel without reviews has averageRating null and reviewCount 0",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const h = pm.response.json().data;",
              "pm.test('averageRating null', () => pm.expect(h.averageRating).to.eql(null));",

{
  "info": {
    "name": "40 Reviews",
    "description": "Hotel review feature (R1 to R5). B1: Review model rules and hotel averageRating/reviewCount.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Review model rejects invalid reviews (R1, R2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = JSON.parse(pm.environment.get('reviewModelRejects'));",
              "pm.test('rating 0 is rejected', () => pm.expect(r.rating0).to.eql('ValidationError'));",
              "pm.test('rating 6 is rejected', () => pm.expect(r.rating6).to.eql('ValidationError'));",
              "pm.test('rating 3.5 is rejected', () => pm.expect(r.rating3point5).to.eql('ValidationError'));",
              "pm.test('missing rating is rejected', () => pm.expect(r.ratingMissing).to.eql('ValidationError'));",
              "pm.test('comment over 1000 characters is rejected', () => pm.expect(r.comment1001).to.eql('ValidationError'));",
              "pm.test('second review for the same booking is rejected by the unique index', () => pm.expect(r.sameBooking).to.eql('DuplicateKey'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel2Id}}",
        "header": []
      }
    },
    {
      "name": "Average after creating ratings 4, 5, 2 is 3.7 of 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const s = JSON.parse(pm.environment.get('hotel2StatsAfterCreate'));",
              "pm.test('averageRating 3.7', () => pm.expect(s.averageRating).to.eql(3.7));",
              "pm.test('reviewCount 3', () => pm.expect(s.reviewCount).to.eql(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel2Id}}",
        "header": []
      }
    },
    {

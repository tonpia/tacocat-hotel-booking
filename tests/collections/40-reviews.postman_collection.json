    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "GET /hotels/:hotelId/reviews is public and lists the hotel's reviews (R4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success true', () => pm.expect(body.success).to.eql(true));",
              "pm.test('count 2', () => pm.expect(body.count).to.eql(2));",
              "pm.test('data has 2 reviews', () => pm.expect(body.data).to.have.lengthOf(2));",
              "pm.test('averageRating 2.5', () => pm.expect(body.averageRating).to.eql(2.5));",
              "pm.test('ratings are 4 and 1', () => pm.expect(body.data.map((r) => r.rating).sort()).to.eql([1, 4]));",
              "pm.test('only this hotel\\'s reviews', () => body.data.forEach((r) => pm.expect(r.hotel).to.eql(pm.environment.get('hotel2Id'))));",
              "pm.test('newest first', () => { for (let i = 1; i < body.data.length; i++) { pm.expect(new Date(body.data[i - 1].createdAt).getTime()).to.be.at.least(new Date(body.data[i].createdAt).getTime()); } });",
              "pm.test('reviewer shows name only', () => body.data.forEach((r) => { pm.expect(r.user.name).to.eql('Test User One'); pm.expect(Object.keys(r.user).sort()).to.eql(['_id', 'name']); }));",
              "pm.test('review has rating, comment, booking, createdAt', () => pm.expect(body.data[0]).to.include.keys('rating', 'comment', 'booking', 'createdAt'));",
              "const stats = JSON.parse(pm.environment.get('hotel2StatsAfterRejects'));",
              "pm.test('averageRating and count match the hotel', () => { pm.expect(body.averageRating).to.eql(stats.averageRating); pm.expect(body.count).to.eql(stats.reviewCount); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel2Id}}/reviews",
        "header": []
      }
    },

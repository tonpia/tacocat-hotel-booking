{
  "info": {
    "name": "20 Hotels",
    "description": "Hotel endpoints after the Hospital to Hotel rename (A1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create hotel without token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"New Hotel\", \"address\": \"5 Test Road\", \"tel\": \"020000000\"}"
        }
      }
    },
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
        }
      }
    },
    {
      "name": "Login user1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('user1Token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{user1Email}}\", \"password\": \"{{user1Password}}\"}"
        }
      }
    },
    {
      "name": "List hotels is public",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has hotels', () => pm.expect(pm.response.json().count).to.be.above(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": []
      }
    },
    {
      "name": "Get one hotel",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('name', () => pm.expect(pm.response.json().data.name).to.eql('Taco Hotel Bangkok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hotels/{{hotel1Id}}",
        "header": []
      }
    },
    {
      "name": "Create hotel as user is 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"New Hotel\", \"address\": \"5 Test Road\", \"tel\": \"020000000\"}"
        }
      }
    },
    {
      "name": "Create hotel as admin is 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('newHotelId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"New Hotel\", \"address\": \"5 Test Road\", \"tel\": \"020000000\"}"
        }
      }
    },
    {
      "name": "Create hotel without address is 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"No Address\", \"tel\": \"020000000\"}"
        }
      }
    },
    {
      "name": "Create hotel without tel is 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/hotels",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"No Tel\", \"address\": \"1 Road\"}"
        }
      }
    },
    {
      "name": "Old /hospitals path is gone",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/hospitals",
        "header": []
      }
    }
  ]
}